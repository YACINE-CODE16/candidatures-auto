# Réglages facultatifs. .env n'est jamais versionné ; son contenu est sauvegardé dans le coffre chiffré.
# Dans le cloud, seules COFFRE_CLE et GOOGLE_CLIENT_JSON vont dans les réglages de l'environnement.

# 1 = un dossier approuvé par le vérificateur passe directement en « Validée », donc part au prochain envoi
VALIDATION_AUTO=1

# 1 = LinkedIn et JobTeaser connectés (compte du candidat). Désactivés par défaut : alertes Gmail, recherche web,
# Workday et sites carrière suffisent, et aucun mot de passe LinkedIn n'est stocké.
SOURCES_CONNECTEES=0

# 1 = autoriser l'ajout au CV de projets « En cours », à réaliser avant un entretien. Choix du candidat.
PROJETS_EN_COURS=0

# 1 = autoriser la candidature simplifiée JobTeaser / LinkedIn (désactivée : on postule sur le site de l'entreprise)
CANDIDATURE_SIMPLIFIEE=0

# Plafonds : ceux de l'abonnement (outils/plafonds.py) s'appliquent si ces lignes restent commentées. 0 = sans limite.
# DOSSIERS_JOUR=10
# ENVOIS_JOUR=10
# CHASSEUR_PAR_JOUR=1
# CYCLES=1
# MODELE_REDACTEUR=haiku
# MODELE_VERIFICATEUR=sonnet

# Chromium à utiliser si le navigateur intégré à Playwright n'est pas installé
CHROMIUM_PATH=

# Mots de passe de comptes candidats déjà existants : MDP_<MOT DU DOMAINE> (ex. MDP_EXEMPLE pour carrieres.exemple.fr).
# EMAIL_<MOT> facultatif si l'identifiant n'est pas l'adresse Gmail habituelle. Les autres comptes sont créés par
# le postuleur, qui les ajoute ici lui-même.

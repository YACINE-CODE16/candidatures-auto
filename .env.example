# Copier ce fichier en .env puis remplir les valeurs. .env n'est jamais versionné.

# Clé API Anthropic : facultative si le pipeline est lancé depuis Claude Code avec un abonnement
ANTHROPIC_API_KEY=

# Google Sheet « Pipeline Candidatures 2027 » (compte de service)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json
SHEET_ID=
SHEET_ONGLET=Offres

# 1 = un dossier approuvé par le vérificateur passe directement en « Validée »
VALIDATION_AUTO=1

# Chromium à utiliser si le navigateur intégré à Playwright n'est pas installé
CHROMIUM_PATH=

# Mots de passe des comptes candidats : MDP_<MOT DU DOMAINE> (ex. MDP_THALESGROUP pour careers.thalesgroup.com)
# EMAIL_<MOT> facultatif si l'identifiant n'est pas l'adresse Gmail habituelle.
MDP_CEA=

# 1 = autoriser la candidature simplifiée JobTeaser / LinkedIn (désactivée : on postule sur le site de l'entreprise)
CANDIDATURE_SIMPLIFIEE=0
